# Copy to .env for local runs (never commit .env). On a host, set these as environment variables.

# Secret that unlocks the server. Generate one:  openssl rand -hex 24
API_TOKEN=

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # the secret "service_role" key. Server only, never in the website.
# SUPABASE_BUCKET=music

# Automatic lyrics (speech-to-text). Groq by default; leave empty to disable auto lyrics.
WHISPER_API_KEY=
# WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# WHISPER_MODEL=whisper-large-v3
#   OpenAI instead: WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions  WHISPER_MODEL=whisper-1

# Only let your own site call the server (comma separated). Recommended.
# ALLOWED_ORIGINS=https://your-player.vercel.app

# Longest video accepted, in seconds (default 1800 = 30 min)
# MAX_DURATION_SEC=1800

# If YouTube says "confirm you're not a bot": base64 of a Netscape cookies.txt (see README)
# YT_COOKIES_B64=
